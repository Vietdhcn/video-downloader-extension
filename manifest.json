{
  "manifest_version": 3,
  "name": "Video Catcher – Catch & download videos",
  "version": "1.8.0",
  "description": "Bắt & tải video như IDM: nút \"Tải video này\" trên mọi video, chọn chất lượng, tải HLS/DASH/livestream thành MP4, hoặc ghi lại video đang phát.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "webRequest",
    "webNavigation",
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video Catcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "hook.js",
        "lib/yt-capture.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/locales/en.js",
        "lib/locales/vi.js",
        "lib/i18n.js",
        "lib/youtube.js",
        "lib/position.js",
        "lib/frames.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
